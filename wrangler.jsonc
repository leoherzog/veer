{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "veer",
  "main": "src/index.ts",
  // Capped by the workerd bundled with @cloudflare/vitest-pool-workers: a
  // date newer than that binary supports makes `npm test` fail at startup.
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  // Setting a build command replaces Wrangler's default dev watch on src/, so
  // src stays listed or Worker edits stop reloading.
  "build": {
    "command": "npm run build:frontend",
    "watch_dir": ["src", "frontend/src"]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "veer-db",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "veer_clicks"
    }
  ],
  "vars": {
    "WORKER_NAME": "veer",
    "BETTER_AUTH_URL": "https://veer.production.example",
    "INSTANCE_NAME": "",
    "DEMO_MODE": "",
    // Stats queries read this dataset; keep it equal to analytics_engine_datasets.
    "AE_DATASET": "veer_clicks"
  },
  // Hourly cron. The scheduled handler (src/scheduled.ts) early-returns when
  // DEMO_MODE is unset, so non-demo deployments incur one cheap no-op per hour.
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "placement": { "mode": "smart" },
  "observability": { "enabled": true },
  "env": {
    "demo": {
      "name": "veer-demo",
      "vars": {
        "WORKER_NAME": "veer-demo",
        "BETTER_AUTH_URL": "https://demo.veer.ing",
        "INSTANCE_NAME": "Veer Demo",
        "DEMO_MODE": "true",
        "AE_DATASET": "veer_clicks_demo"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "veer-db-demo",
          "database_id": "c9c779fe-a0a4-4326-af74-a55b836b5b86",
          "migrations_dir": "drizzle/migrations"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "KV",
          "id": "c8636bccd191475c865d413edd4813ed"
        }
      ],
      "analytics_engine_datasets": [
        {
          "binding": "ANALYTICS",
          "dataset": "veer_clicks_demo"
        }
      ],
      "routes": [
        {
          "pattern": "demo.veer.ing",
          "custom_domain": true
        }
      ]
    }
  }
}
