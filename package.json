{
  "name": "veer",
  "version": "1.0.0",
  "scripts": {
    "predev": "npm run db:migrate:local",
    "dev": "wrangler dev --types",
    "build:frontend": "esbuild frontend/src/app.js --bundle --format=esm --minify --outdir=public/dist",
    "deploy": "wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply veer-db --local",
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:local": "node scripts/seed.ts > scripts/seed.generated.sql && wrangler d1 execute veer-db --local --file=scripts/seed.generated.sql",
    "seed:remote": "node scripts/seed.ts > scripts/seed.generated.sql && wrangler d1 execute veer-db-demo --remote --env demo --file=scripts/seed.generated.sql"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@awesome.me/webawesome": "^3.14.0",
    "@better-auth/passkey": "^1.6.25",
    "better-auth": "^1.6.25",
    "chart.js": "^4.5.1",
    "chartjs-chart-geo": "^4.3.6",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  }
}
