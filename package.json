{
  "name": "veer",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "predev": "npm run build && npm run db:migrate:local",
    "dev": "concurrently \"node frontend/esbuild.mjs --watch\" \"wrangler dev\"",
    "build:frontend": "node frontend/esbuild.mjs --minify",
    "build": "wrangler types && npm run build:frontend",
    "deploy": "npm run build && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply veer-db --local",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:local": "tsx scripts/seed.ts && wrangler d1 execute veer-db --local --file=scripts/seed.generated.sql",
    "seed:remote": "tsx scripts/seed.ts && wrangler d1 execute veer-db --remote --file=scripts/seed.generated.sql"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@awesome.me/webawesome": "^3.12.0",
    "@better-auth/passkey": "^1.6.25",
    "@opentelemetry/api": "^1.9.1",
    "better-auth": "^1.6.25",
    "chart.js": "^4.5.1",
    "chartjs-chart-geo": "^4.3.6",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.9",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.120.0"
  }
}
